# Copiar a .env.local para desarrollo. Todo lo que lleva prefijo VITE_ termina DENTRO
# del JavaScript que descarga el visitante: aquí solo van URLs públicas, nunca secretos.
# Los secretos (ADMIN_TOKEN) viven en /etc/navaja-api.env dentro de la Raspberry.

# Vacío o ausente = el formulario de leads no envía nada (el reporte sigue funcionando).
VITE_API_URL=https://api.industriasmuneco.com

# En local, contra la Pi por SSH tunnel o contra el server corriendo aquí mismo:
# VITE_API_URL=http://127.0.0.1:8787
